# Plantilla de variables de entorno.
# Copia este archivo a ".env" y pon tu contraseña real de postgres.
# El archivo .env NO se sube al repositorio (está en .gitignore); este .env.example sí (es una plantilla, sin secretos).

DATABASE_URL=postgresql+psycopg2://postgres:TU_CONTRASEÑA@localhost:5432/diagnostico

# Secreto para firmar los tokens JWT. Debe ser una cadena larga y aleatoria.
# Genera el tuyo con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIA_ESTO_por_una_cadena_larga_y_aleatoria
