# Environment variable template.
# Copy this file to ".env" and put in your real postgres password.
# The .env file is NOT committed (it is in .gitignore); this .env.example is (it is a template, with no secrets).

DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/diagnostico

# Secret used to sign the JWT tokens. It must be a long, random string.
# Generate your own with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_THIS_with_a_long_random_string

# Password of the ADMIN user created by the seed (python -m app.seed).
# Pick your own; it only lives in your local .env (it is not committed).
ADMIN_PASSWORD=pick_a_password

# Frontend origins (URLs) allowed to call the API (CORS).
# Several can be given, separated by commas, so the local and the deployed environments coexist:
#   FRONTEND_ORIGINS=http://localhost:5173,https://my-frontend.onrender.com
# No trailing slash. If it is not set, http://localhost:5173 is used.
FRONTEND_ORIGINS=http://localhost:5173
